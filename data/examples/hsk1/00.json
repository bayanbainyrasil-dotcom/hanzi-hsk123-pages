[{"k":"爱","m":[{"ru":"любить кого-то, испытывать чувство","ex":[{"z":"我爱我的家人。","p":"Wǒ ài wǒ de jiārén.","r":"Я люблю свою семью."},{"z":"她很爱她的孩子。","p":"Tā hěn ài tā de háizi.","r":"Она очень любит своего ребёнка."}]},{"ru":"любить что-то делать","ex":[{"z":"我爱吃中国菜。","p":"Wǒ ài chī Zhōngguó cài.","r":"Я люблю китайскую еду."},{"z":"他爱看电影。","p":"Tā ài kàn diànyǐng.","r":"Он любит смотреть фильмы."}]}]},{"k":"八","m":[{"ru":"восемь","ex":[{"z":"我家有八口人。","p":"Wǒ jiā yǒu bā kǒu rén.","r":"В моей семье восемь человек."},{"z":"现在是八点。","p":"Xiànzài shì bā diǎn.","r":"Сейчас восемь часов."}]}]},{"k":"吃","m":[{"ru":"есть, принимать пищу","ex":[{"z":"我们一起吃饭吧。","p":"Wǒmen yìqǐ chī fàn ba.","r":"Давай поедим вместе."},{"z":"你想吃什么？","p":"Nǐ xiǎng chī shénme?","r":"Что ты хочешь съесть?"}]},{"ru":"принимать лекарство","ex":[{"z":"他每天吃药。","p":"Tā měitiān chī yào.","r":"Он каждый день принимает лекарство."},{"z":"吃了药就好了。","p":"Chī le yào jiù hǎo le.","r":"Примешь лекарство — и станет легче."}]}]},{"k":"大","m":[{"ru":"большой по размеру","ex":[{"z":"这个房间很大。","p":"Zhège fángjiān hěn dà.","r":"Эта комната очень большая."},{"z":"我买了一个大苹果。","p":"Wǒ mǎi le yí ge dà píngguǒ.","r":"Я купил большое яблоко."}]},{"ru":"старший по возрасту","ex":[{"z":"他比我大两岁。","p":"Tā bǐ wǒ dà liǎng suì.","r":"Он на два года старше меня."},{"z":"我姐姐比我大。","p":"Wǒ jiějie bǐ wǒ dà.","r":"Моя сестра старше меня."}]}]},{"k":"点","m":[{"ru":"час на часах","ex":[{"z":"现在是三点。","p":"Xiànzài shì sān diǎn.","r":"Сейчас три часа."},{"z":"我们八点见。","p":"Wǒmen bā diǎn jiàn.","r":"Встретимся в восемь."}]},{"ru":"немного, чуть-чуть","ex":[{"z":"我会说一点儿汉语。","p":"Wǒ huì shuō yìdiǎnr Hànyǔ.","r":"Я немного говорю по-китайски."},{"z":"请给我一点儿水。","p":"Qǐng gěi wǒ yìdiǎnr shuǐ.","r":"Дай мне немного воды, пожалуйста."}]}]},{"k":"好","m":[{"ru":"хороший","ex":[{"z":"这是一本好书。","p":"Zhè shì yì běn hǎo shū.","r":"Это хорошая книга."},{"z":"今天天气很好。","p":"Jīntiān tiānqì hěn hǎo.","r":"Сегодня хорошая погода."}]},{"ru":"ладно, согласен","ex":[{"z":"好，我们走吧。","p":"Hǎo, wǒmen zǒu ba.","r":"Хорошо, пойдём."},{"z":"好，就这样。","p":"Hǎo, jiù zhèyàng.","r":"Ладно, так и сделаем."}]}]},{"k":"会","m":[{"ru":"уметь, владеть навыком","ex":[{"z":"我会说汉语。","p":"Wǒ huì shuō Hànyǔ.","r":"Я умею говорить по-китайски."},{"z":"他会开车。","p":"Tā huì kāi chē.","r":"Он умеет водить машину."}]},{"ru":"вероятно, произойдёт в будущем","ex":[{"z":"明天会下雨。","p":"Míngtiān huì xià yǔ.","r":"Завтра будет дождь."},{"z":"他会来吗？","p":"Tā huì lái ma?","r":"Он придёт?"}]}]},{"k":"看","m":[{"ru":"смотреть","ex":[{"z":"我们看电影吧。","p":"Wǒmen kàn diànyǐng ba.","r":"Давай посмотрим фильм."},{"z":"他在看电视。","p":"Tā zài kàn diànshì.","r":"Он смотрит телевизор."}]},{"ru":"читать","ex":[{"z":"我每天看书。","p":"Wǒ měitiān kàn shū.","r":"Я каждый день читаю."},{"z":"你看这本书了吗？","p":"Nǐ kàn zhè běn shū le ma?","r":"Ты читал эту книгу?"}]},{"ru":"навещать; идти к врачу","ex":[{"z":"周末我去看奶奶。","p":"Zhōumò wǒ qù kàn nǎinai.","r":"В выходные я поеду к бабушке."},{"z":"我去医院看病。","p":"Wǒ qù yīyuàn kàn bìng.","r":"Я иду в больницу к врачу."}]}]},{"k":"上","m":[{"ru":"на, сверху","ex":[{"z":"书在桌子上。","p":"Shū zài zhuōzi shang.","r":"Книга на столе."},{"z":"猫在椅子上睡觉。","p":"Māo zài yǐzi shang shuìjiào.","r":"Кошка спит на стуле."}]},{"ru":"садиться в транспорт; идти куда-то","ex":[{"z":"他上车了。","p":"Tā shàng chē le.","r":"Он сел в машину."},{"z":"我八点上班。","p":"Wǒ bā diǎn shàng bān.","r":"Я иду на работу в восемь."}]}]},{"k":"下","m":[{"ru":"внизу, под","ex":[{"z":"猫在桌子下面。","p":"Māo zài zhuōzi xiàmian.","r":"Кошка под столом."},{"z":"书在床下。","p":"Shū zài chuáng xià.","r":"Книга под кроватью."}]},{"ru":"следующий по времени","ex":[{"z":"下个月我去中国。","p":"Xià ge yuè wǒ qù Zhōngguó.","r":"В следующем месяце я поеду в Китай."},{"z":"我们下次再见。","p":"Wǒmen xià cì zài jiàn.","r":"Увидимся в следующий раз."}]}]}]